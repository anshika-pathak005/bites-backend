DB_URL=jdbc:mysql://localhost:3306/db_name
DB_USERNAME=
DB_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:3000

JWT_SECRET=replace-with-a-real-base64-256-bit-secret
JWT_ACCESS_EXP_MS=900000
JWT_REFRESH_EXP_MS=604800000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay test-mode keys — get these from the Razorpay Dashboard >
# Settings > API Keys (make sure "Test Mode" is toggled on there).
# RAZORPAY_KEY_ID is safe to expose to the frontend (it's returned in the
# checkout API response so the Razorpay widget can open) — RAZORPAY_KEY_SECRET
# must NEVER leave the backend, it's only used server-side to create orders
# and verify payment signatures.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Dashboard > Settings > Webhooks, when you add the webhook URL below —
# used to verify that a webhook call genuinely came from Razorpay.
RAZORPAY_WEBHOOK_SECRET=

DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

PORT=8080
SPRING_PROFILES_ACTIVE=dev
